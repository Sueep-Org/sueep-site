# Sueep site + ERP environment variables.
#
# Every variable the code reads is listed here. Real values live in
# Vercel (Project -> Settings -> Environment Variables). For local dev,
# pull them with `vercel env pull .env.local` or copy them by hand.
#
# Two local files, because the Prisma CLI only reads `.env`:
#   .env        DATABASE_URL, DIRECT_URL, ERP_ENCRYPTION_KEY, QBO_*
#   .env.local  everything else (Next.js reads both; .env.local wins)
# Scripts load whichever they need, e.g. `npx tsx --env-file=.env --env-file=.env.local scripts/x.ts`.
#
# REQUIRED = the site or ERP breaks without it. OPTIONAL = a feature turns off.

# ---------------------------------------------------------------------------
# Database (Neon Postgres) - REQUIRED
# ---------------------------------------------------------------------------
# WARNING: local dev and the live site share ONE database today. Anything you
# do locally hits real data. See README "Database and migrations".
# DATABASE_URL = pooled connection (host contains "-pooler").
# DIRECT_URL   = direct connection (used by `prisma migrate`).
# Add &connect_timeout=15 if you see timeouts after idle (Neon scale-to-zero).
# Local Docker (docker-compose.yml): use postgresql://postgres:postgres@localhost:5432/sueep_erp for both.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Firebase - REQUIRED (ERP sign-in and file uploads to Firebase Storage)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ---------------------------------------------------------------------------
# ERP security - REQUIRED
# ---------------------------------------------------------------------------
# Signs ERP session cookies. Generate with: openssl rand -hex 32
ERP_SESSION_SECRET=min-32-chars-random-use-openssl-rand-hex-32
# AES-256 key for SSNs, bank numbers, Company Info logins and QuickBooks tokens.
# 32 bytes, base64. Generate with: openssl rand -base64 32
# NEVER change or lose this: every encrypted value becomes unreadable.
# Keep a copy in the company password manager, not only in Vercel.
ERP_ENCRYPTION_KEY=base64-32-byte-key
# Comma-separated emails that are always made ADMIN when they sign in.
ERP_ADMIN_EMAILS=admin1@sueep.com,admin2@sueep.com
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to every /api/cron/* route.
# Generate with: openssl rand -hex 32
CRON_SECRET=random-cron-secret

# ---------------------------------------------------------------------------
# URLs
# ---------------------------------------------------------------------------
# ERP base URL used in links inside emails. Production: https://app.sueep.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Marketing site base URL for public links (clock-in, info and upload links). Defaults to https://sueep.com
# NEXT_PUBLIC_SITE_URL=https://sueep.com
# Residential painting contract link shown after checkout. Defaults to <site>/painting/contract
# NEXT_PUBLIC_RESIDENTIAL_PAINTING_CONTRACT_URL=

# ---------------------------------------------------------------------------
# Email (Resend) - REQUIRED for any email
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_key
# Sender address. Each email sets its own display name (Sueep ERP / Sueep / Sueep Website).
RESEND_FROM="Sueep <noreply@mail.sueep.com>"
# Where website forms go, and the contact address shown on public pages. Defaults to contact@sueep.com
# CONTACT_TO_EMAIL=contact@sueep.com
# Backup delivery for website forms. Defaults to the company FormSubmit endpoint in code.
# FORMSUBMIT_ENDPOINT=https://formsubmit.co/your_id
# Starting recipients for two emails, used only until someone saves them on
# the ERP Notifications page (the saved setting then wins).
# SAFETY_ESCALATION_EMAIL=safety@sueep.com
# TIME_OFF_NOTIFICATION_EMAIL=office@sueep.com

# ---------------------------------------------------------------------------
# Stripe - REQUIRED for website residential painting checkout
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_or_sk_test_your_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_pk_test_your_publishable_key
# Signing secret of the webhook pointing at /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ---------------------------------------------------------------------------
# QuickBooks Online - OPTIONAL (Finance dashboard sync, invoices to QuickBooks)
# ---------------------------------------------------------------------------
# Keys from the Intuit Developer app (developer.intuit.com). Production and
# sandbox have different keys. Connect from ERP -> QuickBooks after setting these.
# QBO_CLIENT_ID=your_intuit_client_id
# QBO_CLIENT_SECRET=your_intuit_client_secret
# "production" or "sandbox" (anything else = sandbox). Local dev: sandbox.
# QBO_ENVIRONMENT=sandbox
# Must exactly match a Redirect URI on the Intuit app.
# Local: http://localhost:3000/api/erp/quickbooks/callback   Production: https://app.sueep.com/api/erp/quickbooks/callback
# QBO_REDIRECT_URI=http://localhost:3000/api/erp/quickbooks/callback

# ---------------------------------------------------------------------------
# HubSpot - OPTIONAL (deals, invoices, walk dates, webhook)
# ---------------------------------------------------------------------------
# Private app token (HubSpot -> Settings -> Integrations -> Private apps).
# HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token
# Same private app's client secret; verifies /api/integrations/hubspot/webhook.
# HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret
# Pipeline and stage IDs. Print them with: npm run hubspot:pipelines
# HUBSPOT_PIPELINE_STAGE_MAP={"postConstruction":{"pipelineId":"","stages":{"quoteApproved":"","workInProgress":"","workCompleted":"","billing":""}},"janitorial":{"pipelineId":"","stages":{"quoteApproved":"","workInProgress":"","workCompleted":"","walkthrough":"","proposal":"","activeTurnovers":""}}}
# Deal properties holding a post-construction project's start / end date
# (syncDealsToProjects.ts). Check which property is really filled on real deals first.
# HUBSPOT_PROJECT_START_DATE_PROPERTY=fecha_de_inicio_del_contrato
# HUBSPOT_PROJECT_END_DATE_PROPERTY=

# ---------------------------------------------------------------------------
# Meta ads - OPTIONAL (ERP Ad spend page). Full setup: META_ADS_SETUP.md
# ---------------------------------------------------------------------------
# META_ADS_ACCESS_TOKEN=your_system_user_token
# META_AD_ACCOUNT_ID=act_your_ad_account_number

# ---------------------------------------------------------------------------
# DocuSeal - OPTIONAL, legacy (real estate agreement signing embed only)
# ---------------------------------------------------------------------------
# DOCUSEAL_API_KEY=your_key_here
# DOCUSEAL_API_URL=https://api.docuseal.com
# DOCUSEAL_REAL_ESTATE_TEMPLATE_ID=your_real_estate_template_id
# Sueep's signer on those agreements. Set to a person who still works here.
# DOCUSEAL_SUEEP_SIGNER_EMAIL=someone@sueep.com

# ---------------------------------------------------------------------------
# Set automatically by Vercel, do not add: VERCEL_ENV, VERCEL_URL, NODE_ENV
# ---------------------------------------------------------------------------
