model LaborEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  workDate DateTime

  workerName      String
  role            String?
  hours           Float
  /// Clock-in time as "HH:MM" (24h), e.g. "08:00". Null for entries logged before this field existed.
  clockIn         String?
  /// Cents per hour (e.g. $28.84/hr → 2884)
  hourlyRateCents Int

  /// Portion of `hours` spent commuting rather than on-site, e.g. 1 of a 9-hour shift.
  commuteHours Float?

  /// COMPANY_VAN | EMPLOYEE_VEHICLE | PICKUP | MEETUP_SPOT — how this worker got to the job that day
  transportationMethod String?

  taskDescription String?

  /// Deprecated: superseded by `sovItems` (multi-select). Kept only so old rows
  /// aren't silently unlinked; no longer read or written by the app.
  sovItemId String?
  sovItem   ProjectSOVItem? @relation(fields: [sovItemId], references: [id], onDelete: SetNull)

  /// SOV items this entry's work covers. A shift can span multiple tasks.
  sovItems ProjectSOVItem[] @relation("LaborEntrySOVItems")

  qualityRating String?
  qualityNotes  String?

  /// Location when entry was created (latitude)
  locationLatitude  Float?
  /// Location when entry was created (longitude)
  locationLongitude Float?
  /// Accuracy of location in meters
  locationAccuracy  Float?
  /// Timestamp when location was last captured
  lastLocationAt    DateTime?

  @@index([projectId])
  @@index([employeeId])
  @@index([workDate])
}

model MaterialEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  usedOn    DateTime
  /// CLEANING_PRODUCTS | PAINT
  category  String
  itemName  String
  quantity  Float?
  unit      String?
  costCents Int
  notes     String?

  @@index([projectId])
  @@index([usedOn])
  @@index([category])
}

model DistanceEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  travelDate DateTime
  miles      Float
  personName String?
  notes      String?

  @@index([projectId])
  @@index([travelDate])
}

/// ADMIN | PROJECT_MANAGER | SUPERVISOR | ESTIMATION | EMPLOYEE
model ErpUser {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  firebaseUid String   @unique
  email       String   @unique
  role        String   @default("EMPLOYEE")

  supervisorProjects            Project[]
  dayAssignments                ProjectDayAssignment[]          @relation("ProjectDayAssignmentSupervisor")
  dayAssignmentsAsPM            ProjectDayAssignment[]          @relation("ProjectDayAssignmentPM")
  supervisorChangeOrders        ProjectChangeOrder[]             @relation("ChangeOrderSupervisor")
  coDayAssignments               ChangeOrderDayAssignment[]      @relation("ChangeOrderDayAssignmentSupervisor")
  coDayAssignmentsAsPM           ChangeOrderDayAssignment[]      @relation("ChangeOrderDayAssignmentPM")
  projectNotes                  ProjectNote[]
  buildingNotes                 BuildingNote[]
  hubspotSovAliasesCreated      HubSpotSovAlias[]
  hubspotUnitAliasesCreated     HubSpotUnitAlias[]
  hubspotInvoiceMatchesResolved HubSpotInvoiceLineItemMatch[]
  scheduleNudgeDismissalsMade   ProjectScheduleNudgeDismissal[]

  @@index([firebaseUid])
}

/// A team-visible, timestamped note on a project (e.g. "had to pause cleaning
/// due to maintenance needed before we finish the unit") — an append-only log,
/// not a single editable description. Shown in the project's Overview tab.
model ProjectNote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  body String

  /// Snapshot of the author's name at post time, so the note stays readable
  /// even if their ERP account is later removed.
  authorName   String
  authorUserId String?
  authorUser   ErpUser? @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

/// A team-visible, timestamped note on a building (e.g. PM contact changes,
/// access instructions) — an append-only log, shown in the building's Notes tab.
model BuildingNote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  body String

  /// Snapshot of the author's name at post time, so the note stays readable
  /// even if their ERP account is later removed.
  authorName   String
  authorUserId String?
  authorUser   ErpUser? @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([buildingId])
}

/// A supervisor's planned coverage of a project on a specific future day —
/// distinct from LaborEntry (which records work that already happened).
/// Lets a PM click a day on the schedule calendar, pick a project, and
/// assign the supervisor who'll be there, before any labor is logged.
model ProjectDayAssignment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// The calendar date this assignment is for (stored as midnight UTC)
  date DateTime

  /// Optional "HH:MM" (24h) local time, e.g. "08:00". All-day event on the
  /// calendar invite if either time is unset.
  startTime String?
  endTime   String?

  /// Nullable so a day can be covered by a PM only (see projectManagerUserId)
  /// with no supervisor on site, a rare but real case.
  supervisorUserId String?
  supervisorUser   ErpUser? @relation("ProjectDayAssignmentSupervisor", fields: [supervisorUserId], references: [id], onDelete: Cascade)

  /// Set when only the PM is at the project that day, no supervisor. Not
  /// synced onto Project (unlike supervisorUserId), calendar/day-assignment
  /// concept only, and no calendar-invite email goes out for PM-only days.
  projectManagerUserId String?
  projectManager       ErpUser? @relation("ProjectDayAssignmentPM", fields: [projectManagerUserId], references: [id], onDelete: SetNull)

  /// Set when this row was generated by a multi-day range or repeat action
  /// (see ProjectScheduleSeries) rather than a single one-off day assign.
  seriesId String?
  series   ProjectScheduleSeries? @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  /// SOV line items this scheduled day is working on (Post-Construction).
  sovItems ProjectSOVItem[] @relation("DayAssignmentSOVItems")

  /// Janitorial/turnover scope categories this scheduled day covers — values
  /// from TURNOVER_SCOPE_OPTIONS (src/lib/erp/turnoverScope.ts), e.g. "CLEAN",
  /// "PAINT". Free-standing from TurnoverRequest's contracted scope flags,
  /// this is what's actually being worked on for this specific day.
  scopeItems String[] @default([])

  /// Change order(s) this scheduled day's work is for, if any — leaves it
  /// untagged (empty) for plain project-scope work. A day already has at
  /// most one ProjectDayAssignment (see @@unique below), so this tags which
  /// CO(s) that single day's coverage applies to rather than creating a
  /// separate assignment row per CO.
  changeOrders ProjectChangeOrder[] @relation("DayAssignmentChangeOrders")

  /// Free-text note about what's happening this day — mainly used when
  /// there are no SOV items yet to pick from, so coverage can still be
  /// described and shown on the calendar.
  comment String?

  @@unique([projectId, date])
  @@index([date])
  @@index([supervisorUserId])
  @@index([projectManagerUserId])
  @@index([seriesId])
}

/// A worker planned to be on a project on a future day, before any labor is
/// logged — same idea as ProjectDayAssignment but for crew (Employee or
/// Contractor) rather than supervisors, and multiple per project/day since a
/// crew has more than one person. No notification is sent when these are
/// created (unlike the supervisor calendar invite) — may be added later.
model ProjectWorkerDayAssignment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Exactly one of employeeId/contractorId is set per row.
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  contractorId String?
  contractor   Contractor? @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  /// The calendar date this assignment is for (stored as midnight UTC)
  date DateTime

  /// Which SOV line item this specific worker covers this day, when the
  /// project's day (see ProjectDayAssignment.sovItems) has more than one
  /// item picked — e.g. one crew member on patching, another on trim.
  /// Null when the day has zero or one SOV item picked (nothing to split)
  /// or a specific split hasn't been chosen yet.
  assignedSovItemId String?
  assignedSovItem   ProjectSOVItem? @relation("WorkerDayAssignmentSovItem", fields: [assignedSovItemId], references: [id], onDelete: SetNull)

  /// Which turnover scope category (see TURNOVER_SCOPE_OPTIONS) this
  /// specific worker covers this day, when the project's day (see
  /// ProjectDayAssignment.scopeItems) has more than one scope picked — e.g.
  /// one person cleaning, another painting. Null when the day has zero or
  /// one scope item picked, or a specific split hasn't been chosen yet.
  assignedScopeItem String?

  /// Set when this row was generated by a multi-day range or repeat action
  /// (see ProjectScheduleSeries) rather than a single one-off day assign.
  seriesId String?
  series   ProjectScheduleSeries? @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId, date])
  @@unique([projectId, contractorId, date])
  @@index([date])
  @@index([employeeId])
  @@index([contractorId])
  @@index([seriesId])
  @@index([assignedSovItemId])
}

/// The rule behind a "multi-day range" or "repeat weekly" schedule action
/// (see SchedulePlanner's day-assignment modal) — the concrete
/// ProjectDayAssignment/ProjectWorkerDayAssignment rows it generated all
/// point back here via seriesId, so the whole batch can be identified and
/// removed together. Always bounded by an explicit endDate chosen at
/// creation time (like Google Calendar's "Ends on"), so every date is
/// materialized up front — no daily generation job needed.
model ProjectScheduleSeries {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  supervisorUserId     String?
  /// Set when only the PM covers this series, no supervisor, see
  /// ProjectDayAssignment.projectManagerUserId.
  projectManagerUserId String?

  startDate  DateTime
  endDate    DateTime
  /// 0-6 (Sun-Sat), the weekdays this series repeats on. A plain multi-day
  /// range (e.g. Mon-Fri of one job) is just every weekday in between.
  repeatDays Int[]

  /// Optional "HH:MM" (24h) local time, applied to every generated day.
  startTime String?
  endTime   String?

  dayAssignments    ProjectDayAssignment[]
  workerAssignments ProjectWorkerDayAssignment[]

  @@index([projectId])
}

/// A "not today" dismissal of the daily unscheduled-project nudge for one
/// project on one calendar day — global per project+day (not scoped to the
/// dismissing user), since PROJECT_MANAGER is a shared role and this means
/// "the team already decided this doesn't need scheduling today," not a
/// personal per-user to-do list. dismissedByUserId is an audit trail only
/// (same pattern as ProjectNote.authorUser), not a scoping key.
model ProjectScheduleNudgeDismissal {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Midnight UTC, same convention as ProjectDayAssignment.date — always
  /// written via todayEasternAsUtcMidnight(), so exact-equality lookups are fine.
  date DateTime

  dismissedByUserId String?
  dismissedByUser   ErpUser? @relation(fields: [dismissedByUserId], references: [id], onDelete: SetNull)

  @@unique([projectId, date])
  @@index([date])
}

model Employee {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firstName         String
  lastName          String
  email             String? @unique
  phone             String?
  role              String?
  /// HOURLY | SALARY
  payType           String  @default("HOURLY")
  /// Cents per hour (e.g. $18.75 => 1875)
  hourlyPayCents    Int?
  /// Annual salary in cents (e.g. $50,000 => 5000000)
  annualSalaryCents Int?

  /// Paid a fixed amount every month via the Offshore Payroll tab, not tied
  /// to logged hours — a distinct concept from HOURLY/SALARY payType.
  isOffshore               Boolean @default(false)
  /// Fixed monthly pay in cents, only used when isOffshore is true.
  offshoreMonthlyRateCents Int?

  defaultProject String?
  /// ACTIVE | INACTIVE
  status         String    @default("ACTIVE")
  hireDate       DateTime?
  notes          String?

  /// Home address, same free-text convention as Contractor.address.
  address String?
  /// Free-text date of birth (not a DateTime), same convention as Contractor.dateOfBirth.
  dateOfBirth String?

  bankAccountType   String?
  bankAccountNumber String?
  bankRoutingNumber String?

  /// Social Security Number. Masked by default in the UI; only revealed
  /// on-demand via a role-gated endpoint (never shipped in the initial page load).
  ssn String?

  /// Token for the self-service "Employee Information" form, same
  /// mechanism as Contractor.infoToken — lets an employee fill in their own
  /// address/DOB/bank/SSN via a emailed link instead of staff typing it in.
  infoToken       String?   @unique
  infoTokenExpiry DateTime?

  /// Array of document type labels required for compliance (e.g. ["I-9", "OSHA card"])
  requiredDocuments Json @default("[]")

  /// PASSED | FAILED | PENDING | NOT_DONE
  backgroundCheckStatus    String?   @default("NOT_DONE")
  /// Date the check was completed / result received
  backgroundCheckedAt      DateTime?
  /// When this check needs to be re-run (most providers are only good for 1-3 years)
  backgroundCheckExpiresAt DateTime?
  /// Vendor that ran the check (e.g. Checkr, Sterling)
  backgroundCheckProvider  String?
  backgroundCheckNotes     String?
  /// Date the employee signed the FCRA consent form authorizing the check
  backgroundCheckConsentAt DateTime?

  laborEntries                 LaborEntry[]
  documents                    EmployeeDocument[]
  backgroundCheckEvents        EmployeeBackgroundCheckEvent[]
  timeOff                      EmployeeTimeOff[]
  laborAssignments             LaborAssignment[]
  projectLaborAssignments      ProjectLaborAssignment[]
  workerDayAssignments         ProjectWorkerDayAssignment[]
  coWorkerDayAssignments       ChangeOrderWorkerDayAssignment[]
  changeOrderAssignments       ProjectChangeOrderLaborer[]
  contracts                    EmployeeContract[]
  safetyCheckWorkers           SafetyCheckWorker[]
  safetyIncidents              SafetyIncident[]
  commissionProjects           Project[]                      @relation("ProjectCommissionOwner")
  createdProjects              Project[]                      @relation("ProjectCreatedBy")
  reimbursements               Reimbursement[]
  recurringContractCommissions RecurringContract[]
  buildingCommissions          Building[]                     @relation("BuildingCommissionOwner")
  offshorePayrollPayments      OffshorePayrollPayment[]
  bidBonusEntries              BidBonusEntry[]
  salesBidEntries              SalesBidEntry[]

  @@index([status])
  @@index([defaultProject])
  @@index([hourlyPayCents])
  @@index([lastName, firstName])
}

/// Audit trail of backgroundCheckStatus transitions on Employee — a row is
/// written automatically whenever the status changes, so "when did this
/// person get cleared" can be answered later without trusting the current
/// snapshot alone.
model EmployeeBackgroundCheckEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// NULL for the first event recorded on an employee
  previousStatus String?
  /// PASSED | FAILED | PENDING | NOT_DONE
  newStatus      String
  /// Email of the ERP user who made the change
  changedBy      String?

  @@index([employeeId, createdAt])
}

/// A logged block of time off for an employee. No separate request/approval
/// status for now (every row that exists is treated as approved, matching
/// how loosely most things work in this ERP). Deleting a row is how it gets
/// cancelled. Blocks scheduling that employee on the calendar for any day
/// inside [startDate, endDate], overridable by a PM/Admin the same way the
/// quality checklist and safety check gates are (see canOverridePto).
model EmployeeTimeOff {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// Midnight UTC, same convention as ProjectDayAssignment.date — inclusive
  /// on both ends.
  startDate DateTime
  endDate   DateTime

  /// VACATION | SICK | HALF_DAY | UNPAID | OTHER
  type  String  @default("VACATION")
  notes String?

  @@index([employeeId, startDate, endDate])
}

/// Tracks whether an offshore employee's fixed monthly pay has been paid for
/// a given month. The rate itself isn't snapshotted here — Employee.offshoreMonthlyRateCents
/// is read live, since a rate change should apply going forward without
/// needing a "contract" concept the way recurring janitorial contracts do.
model OffshorePayrollPayment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// First of the paid month
  periodStart DateTime
  paidAt      DateTime?

  @@unique([employeeId, periodStart])
}

/// Paid-status record for a BD Caller's weekly bid bonus. The verified-bid
/// count itself is NOT stored here — it's derived live by counting
/// SalesBidEntry rows with sent=true for that employee/week (see
/// countSentBidsByWeek in payroll/page.tsx), same reasoning as
/// OffshorePayrollPayment not snapshotting its rate. A row only exists once
/// someone has toggled paid status for that employee/week.
model BidBonusEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// Monday of the reported week
  weekStart DateTime

  /// Set once the bonus has been paid out
  paidAt DateTime?

  @@unique([employeeId, weekStart])
  @@index([employeeId])
}

/// Manual bid-pipeline log for BD Callers — mirrors the "Sales" tracking
/// sheet columns 1:1 (Date, Project Start Date, Company, Deal, Description,
/// Drawings Y/N, Payout), plus `sent` to mark whether the bid was actually
/// submitted. Bids with sent=true are what feed the weekly bonus count in
/// BidBonusEntry's derived verifiedBids.
model SalesBidEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date             DateTime?
  projectStartDate DateTime?
  company          String
  deal             String?
  description      String?
  /// YES | NO | ASKED
  drawings         String?
  payoutCents      Int?
  sent             Boolean   @default(false)

  @@index([employeeId])
}

model EmployeeDocument {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  documentType String
  title        String?
  issuedAt     DateTime?
  expiresAt    DateTime?
  isVerified   Boolean   @default(false)
  fileUrl      String?
  fileData     Bytes?
  fileMimeType String?
  fileFilename String?
  notes        String?

  @@index([employeeId])
  @@index([documentType])
  @@index([expiresAt])
}

model Reimbursement {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  date       DateTime
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// Who/what the expense was for (e.g. "J Centra - Miyanna Nelson"), not necessarily the employee being reimbursed
  companyOrTeam String
  description   String
  amountCents   Int

  receiptUrl      String?
  receiptData     Bytes?
  receiptMimeType String?
  receiptFilename String?

  /// Set once Finance has paid the employee back
  paidAt DateTime?

  @@index([employeeId])
  @@index([paidAt])
}

model Contractor {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name  String
  email String? @unique

  /// ACTIVE | INACTIVE
  status String @default("ACTIVE")

  /// Paperwork items required. Array of { label: string; url: string }.
  paperwork                  Json?
  paperworkUploadToken       String?   @unique
  paperworkUploadTokenExpiry DateTime?

  /// Manually-entered subset of the subcontractor questionnaire (Company Info, Insurance, Licensing sections — see CONTRACTOR_MANUAL_SECTIONS), used when no CandidateApplication is linked. Same `sub_<key>` shape as CandidateApplication.responses so it renders through the same SubcontractorInfoSection component.
  manualApplicationInfo Json?

  /// Token for the contractor info form link
  infoToken       String?   @unique
  infoTokenExpiry DateTime?

  /// Info collected from contractor via the info form
  contractorFullName String?
  address            String?
  dateOfBirth        String?
  ssn                String?
  bankAccountType    String?
  bankAccountNumber  String?
  bankRoutingNumber  String?
  phone              String?
  hasInsurance       Boolean?

  /// Workers comp coverage, self-reported by the contractor via the info portal; staff can review/correct in the ERP.
  workersCompCarrier      String?
  workersCompPolicyNumber String?
  workersCompExpiresAt    DateTime?

  /// Links back to the subcontractor questionnaire this contractor originated from, if any (set via "Convert to Contractor" or the manual link picker on the profile).
  candidateApplicationId String?               @unique
  candidateApplication   CandidateApplication? @relation(fields: [candidateApplicationId], references: [id])

  /// PASSED | FAILED | PENDING | NOT_DONE
  backgroundCheckStatus    String?   @default("NOT_DONE")
  /// Date the check was completed / result received
  backgroundCheckedAt      DateTime?
  /// When this check needs to be re-run (most providers are only good for 1-3 years)
  backgroundCheckExpiresAt DateTime?
  /// Vendor that ran the check (e.g. Checkr, Sterling)
  backgroundCheckProvider  String?
  backgroundCheckNotes     String?
  /// Date the contractor signed the FCRA consent form authorizing the check
  backgroundCheckConsentAt DateTime?

  documents              ContractorDocument[]
  assignments            ContractorAssignment[]
  contracts              ContractorContract[]
  changeOrderAssignments ChangeOrderContractorAssignment[]
  workerDayAssignments   ProjectWorkerDayAssignment[]
  coWorkerDayAssignments ChangeOrderWorkerDayAssignment[]
  backgroundCheckEvents  ContractorBackgroundCheckEvent[]
  timeOff                ContractorTimeOff[]

  @@index([status])
  @@index([name])
}

/// Audit trail of backgroundCheckStatus transitions on Contractor, same
/// reasoning as EmployeeBackgroundCheckEvent.
model ContractorBackgroundCheckEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  /// NULL for the first event recorded on a contractor
  previousStatus String?
  /// PASSED | FAILED | PENDING | NOT_DONE
  newStatus      String
  /// Email of the ERP user who made the change
  changedBy      String?

  @@index([contractorId, createdAt])
}

/// A logged block of time off for a contractor, same shape and scheduling-block
/// behavior as EmployeeTimeOff (see canOverridePto).
model ContractorTimeOff {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  /// Midnight UTC, same convention as EmployeeTimeOff.startDate — inclusive
  /// on both ends.
  startDate DateTime
  endDate   DateTime

  /// VACATION | SICK | HALF_DAY | UNPAID | OTHER
  type  String  @default("VACATION")
  notes String?

  @@index([contractorId, startDate, endDate])
}

