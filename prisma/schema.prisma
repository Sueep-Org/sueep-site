// Sueep internal ERP — PostgreSQL in production (Vercel/Neon). Local: Docker Postgres or Neon dev branch.
// Money fields are integer cents.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  /// Pooled URL (Neon: hostname contains "-pooler") — app queries & serverless
  url       = env("DATABASE_URL")
  /// Direct URL (Neon: no "-pooler") — `prisma migrate` / CLI; set same as url if not using Neon pooler
  directUrl = env("DIRECT_URL")
}

model Project {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// COMMERCIAL | RESIDENTIAL
  segment String @default("COMMERCIAL")
  /// ACTIVE | ON_HOLD | COMPLETE | ARCHIVED
  status  String @default("ACTIVE")

  /// Primary / job-start date shown on PM dashboard
  projectDate    DateTime?
  /// Target end / handoff — drives calendar span & Gantt bar end (optional)
  projectEndDate DateTime?

  jobTitle    String
  supervisor  String?
  description String?

  percentDone     Float @default(0)
  percentInvoiced Float @default(0)

  /// Stamped the first time billingStatus becomes INVOICE_PAID (never
  /// cleared or re-stamped after that) — used both to gate a deal into
  /// commission (billed isn't enough; it must be paid) and to bucket it
  /// into the year it was actually paid in, since projectDate/projectEndDate
  /// are scheduling dates (can be set long before billing wraps up) rather
  /// than a payment-completion signal.
  billingCompletedAt DateTime?

  /// Stamped server-side the moment status transitions to COMPLETE for a
  /// JANITORIAL_TURNOVER_REQUESTS project — the source of truth for "what
  /// completed today" the completion-digest cron queries, independent of
  /// whatever the client's PATCH body happened to include (unlike
  /// projectEndDate, which a specific UI action happens to also set).
  /// Named distinctly from TurnoverRequest.completedAt/ChangeOrder.completedAt
  /// (unrelated fields on other models) so a reader can't mix them up.
  turnoverCompletedAt DateTime?

  /// BILLING | INACTIVE | INVOICE_PAID — manually set per project
  billingStatus String?

  contractValueCents Int?

  estMaterialCents Int?
  estTravelCents   Int?
  estLaborCents    Int?

  actualLaborCents    Int?
  actualMaterialCents Int?
  actualTravelCents   Int?

  estHours    Float?
  actualHours Float?

  /// Estimated duration in days. Actual days worked is computed from labor
  /// logs (distinct dates with a LaborEntry), not stored.
  estimatedDays Int?

  /// Optional link to a Building (set for janitorial turnover projects)
  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  /// Optional link to the originating TurnoverRequest (set for janitorial unit projects)
  turnoverRequestId String?
  turnoverRequest   TurnoverRequest? @relation(fields: [turnoverRequestId], references: [id], onDelete: Cascade)

  /// Set for projects auto-generated by a RecurringContract. The billing
  /// project for a period has this set with turnoverRequestId null; unit
  /// projects for that period have both set.
  recurringContractPeriodId String?
  recurringContractPeriod   RecurringContractPeriod? @relation(fields: [recurringContractPeriodId], references: [id], onDelete: SetNull)

  laborEntries            LaborEntry[]
  materialEntries         MaterialEntry[]
  distanceEntries         DistanceEntry[]
  workOrders              ProjectWorkOrder[]
  workOrderAttachments    ProjectWorkOrderAttachment[]
  images                  ProjectImage[]
  changeOrders            ProjectChangeOrder[]
  sovScheduleRequests     ProjectSovScheduleRequest[]
  hubspotSovAliases       HubSpotSovAlias[]
  hubspotInvoiceMatches   HubSpotInvoiceLineItemMatch[]
  contacts                ProjectContact[]
  contractorAssignments   ContractorAssignment[]
  laborAssignments        ProjectLaborAssignment[]
  checklistItems          ProjectChecklistItem[]
  unitTurnoverChecklist   UnitTurnoverChecklist?
  workOrderRecord         ProjectWorkOrderRecord?
  qualityChecks           QualityCheck[]
  dailySafetyChecks       DailySafetyCheck[]
  contracts               ProjectContract[]
  safetyIncidents         SafetyIncident[]
  sov                     ProjectSOV?
  dayAssignments          ProjectDayAssignment[]
  workerDayAssignments    ProjectWorkerDayAssignment[]
  scheduleSeries          ProjectScheduleSeries[]
  notes                   ProjectNote[]
  scheduleNudgeDismissals ProjectScheduleNudgeDismissal[]

  /// Link to the ERP user assigned as supervisor (used to filter supervisor dashboard)
  supervisorUserId String?
  supervisorUser   ErpUser? @relation(fields: [supervisorUserId], references: [id], onDelete: SetNull)

  /// Per-project pricing package (used for real estate; overrides global default)
  pricingPackage Json?

  /// HubSpot Deal record id (sync from CRM). One ERP project per deal until multi-job-per-deal is modeled.
  hubspotDealId     String? @unique
  hubspotPipelineId String?
  hubspotStageId    String?
  hubspotOwnerId    String?
  hubspotOwnerName  String?
  hubspotOwnerEmail String?

  /// Sales commission (flat 10% of contractValueCents) is marked paid here.
  /// The salesperson defaults to matching hubspotOwnerEmail/hubspotOwnerName
  /// to an Employee, but that match can be wrong (e.g. the HubSpot deal
  /// owner is an estimator, not the salesperson who should get credit) —
  /// commissionEmployeeId lets that be overridden per project.
  commissionPaidAt     DateTime?
  commissionEmployeeId String?
  commissionEmployee   Employee? @relation("ProjectCommissionOwner", fields: [commissionEmployeeId], references: [id], onDelete: SetNull)

  /// ERP user who manually created this project (e.g. via the New Project
  /// form) — used as the commission-owner fallback when there's no HubSpot
  /// deal owner to match against. Left null for projects synced in from
  /// HubSpot or created by an unauthenticated public form.
  createdByEmployeeId String?
  createdByEmployee   Employee? @relation("ProjectCreatedBy", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)

  @@index([segment])
  @@index([commissionEmployeeId])
  @@index([createdByEmployeeId])
  @@index([status])
  @@index([projectDate])
  @@index([recurringContractPeriodId])
}

model Building {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name           String
  builder        String?
  address        String
  pmName         String?
  pmEmail        String?
  pmPhone        String?
  pricingPackage Json?

  /// Salesperson who gets commission credit on turnover unit projects
  /// created for this building — stamped onto each unit Project at creation
  /// (see createProjectFromPayload/generatePeriodForContract) so every unit
  /// resolves to the same owner without per-project assignment. Left
  /// unset for buildings where turnover work isn't yet commission-assigned.
  commissionEmployeeId String?
  commissionEmployee   Employee? @relation("BuildingCommissionOwner", fields: [commissionEmployeeId], references: [id], onDelete: SetNull)

  /// HubSpot Deal covering ALL turnover invoicing for this building (one
  /// deal per building, not per unit) — used to route a paid invoice's line
  /// items back to the right building's units for billing-status automation.
  hubspotDealId String? @unique

  turnoverRequests      TurnoverRequest[]
  contractorAssignments ContractorAssignment[]
  projects              Project[]
  recurringContract     RecurringContract?
  hubspotUnitAliases    HubSpotUnitAlias[]
  hubspotInvoiceMatches HubSpotInvoiceLineItemMatch[]
  notes                 BuildingNote[]

  @@index([name])
  @@index([commissionEmployeeId])
}

enum TurnoverRequestType {
  TURNOVER
  REGULAR
}

enum TurnoverRequestStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  QUALITY_CHECK
  APPROVED
}

model TurnoverRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  requestType TurnoverRequestType @default(TURNOVER)
  unitNumber  String?
  bedrooms    Int?
  bathrooms   Int?
  sqft        Int?
  /// GOOD | FAIR | POOR
  unitQuality String?

  fullPaint           Boolean @default(false)
  touchUpPaint        Int?    @default(0)
  fullClean           Boolean @default(false)
  carpetCleaning      Boolean @default(false)
  materialsAdditional Boolean @default(false)
  ceilingPaint        Boolean @default(false)

  /// Only part of the unit's real bedrooms/bathrooms are being turned (e.g.
  /// 2 of a 3BR/3BA). bedrooms/bathrooms above still record the unit's real
  /// layout; partialTurnLayout is which smaller existing layout bucket
  /// (e.g. "2/2") to price it as instead.
  isPartialTurn     Boolean @default(false)
  partialTurnLayout String?

  otherWork        Boolean @default(false)
  otherDescription String?
  /// Manually entered price for the "Other" line item, in cents.
  otherCents       Int?

  startDate          DateTime?
  endDate            DateTime?
  /// Tenant's actual move-out day, captured on the unit-creation form —
  /// distinct from startDate/endDate above, which drive scheduling/pricing
  /// and are computed from a min/max across several optional per-unit dates
  /// (see unitDateRange in createTurnoverRequests.ts). Purely informational,
  /// previously captured on the form but never actually persisted anywhere.
  moveOutDate        DateTime?
  /// Tenant's actual move-in day — same informational role as moveOutDate.
  moveInDate         DateTime?
  priceCents         Int?
  approvedPriceCents Int?
  pmSignatureUrl     String?
  pmSignedAt         DateTime?
  completedAt        DateTime?
  invoiceGeneratedAt DateTime?
  invoiceUrl         String?
  /// NOT_BILLED | BILLED | PAID
  billingStatus      String    @default("NOT_BILLED")

  createdBy String?
  status    TurnoverRequestStatus @default(PENDING)

  /// Which of the contracted scope items (CLEAN, PAINT, etc, see
  /// lib/erp/turnoverScope.ts) have actually been finished, independent of
  /// the unit's overall status above. Once status is COMPLETED every
  /// contracted item is treated as done regardless of what's in here, this
  /// only matters while the unit is still in progress.
  completedScopeItems Json @default("[]")

  laborAssignments      LaborAssignment[]
  qualityChecks         QualityCheck[]
  projects              Project[]
  hubspotInvoiceMatches HubSpotInvoiceLineItemMatch[]

  @@index([buildingId])
  @@index([status])
  @@index([requestType])
  @@index([buildingId, unitNumber, billingStatus])
}

/// A flat monthly (subscription-style) janitorial contract for a Building,
/// as opposed to one-off per-job pricing. Each month, a scheduled job
/// generates a RecurringContractPeriod: one billing Project holding the
/// flat revenue, plus one TurnoverRequest+Project pair per enrolled unit
/// for cost tracking — see src/lib/erp/recurringContracts.ts.
model RecurringContract {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buildingId String   @unique
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  monthlyRateCents  Int
  /// Day of month (1-28) generation runs for this contract
  billingDayOfMonth Int
  /// ACTIVE | PAUSED | ENDED
  status            String    @default("ACTIVE")
  startDate         DateTime
  endDate           DateTime?
  notes             String?

  /// Salesperson who gets commission credit — manually assigned, since
  /// recurring contracts are created directly in the ERP rather than
  /// synced from a HubSpot deal with an owner.
  commissionEmployeeId String?
  commissionEmployee   Employee? @relation(fields: [commissionEmployeeId], references: [id], onDelete: SetNull)

  units   RecurringContractUnit[]
  periods RecurringContractPeriod[]

  @@index([status])
  @@index([commissionEmployeeId])
}

model RecurringContractUnit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  recurringContractId String
  recurringContract   RecurringContract @relation(fields: [recurringContractId], references: [id], onDelete: Cascade)

  unitNumber   String
  bedrooms     Int?
  bathrooms    Int?
  isCommonArea Boolean @default(false)

  /// Which service lines run each month for this unit — drives the
  /// auto-generated TurnoverRequest's flags
  fullClean      Boolean @default(true)
  carpetCleaning Boolean @default(false)

  /// Soft-remove so past generated periods keep their unit history intact
  active Boolean @default(true)

  @@unique([recurringContractId, unitNumber])
  @@index([recurringContractId])
}

model RecurringContractPeriod {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  recurringContractId String
  recurringContract   RecurringContract @relation(fields: [recurringContractId], references: [id], onDelete: Cascade)

  /// First of the billing month this period covers
  periodStart      DateTime
  billingProjectId String   @unique

  /// Recurring-contract commission (5% of ACV months 1-12, 2% months
  /// 13-24, $0 after) is computed at read time from monthlyRateCents and
  /// elapsed months — only paid status needs to be persisted per period.
  commissionPaidAt DateTime?

  projects Project[]

  @@unique([recurringContractId, periodStart])
}

model LaborAssignment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  turnoverRequestId String
  turnoverRequest   TurnoverRequest @relation(fields: [turnoverRequestId], references: [id], onDelete: Cascade)

  laborerId String
  laborer   Employee @relation(fields: [laborerId], references: [id], onDelete: Cascade)

  role          String?
  assignedDate  DateTime?
  startDate     DateTime?
  endDate       DateTime?
  notes         String?
  materialsUsed Json?

  @@index([turnoverRequestId])
  @@index([laborerId])
}

model QualityCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  turnoverRequestId String?
  turnoverRequest   TurnoverRequest? @relation(fields: [turnoverRequestId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  supervisorName         String
  supervisorSignatureUrl String?
  pmApproval             Boolean @default(false)
  evidencePhotos         Json?
  notes                  String?

  /// SOV line item(s) this check documents completion of (Post-Construction
  /// projects only — turnover requests have no SOV). Same multi-tag pattern
  /// as ProjectDayAssignment.sovItems.
  sovItems ProjectSOVItem[] @relation("QualityCheckSOVItems")

  /// Free-text fallback for "what does this check cover" whenever sovItems
  /// isn't an option — turnover requests (no SOV at all) or a Post-
  /// Construction project with no SOV items configured yet. Same idea as
  /// ProjectDayAssignment.comment's fallback for its SOV picker.
  scopeDescription String?

  @@index([turnoverRequestId])
  @@index([projectId])
}

model DailySafetyCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  checkDate                  DateTime
  supervisorName             String
  groupPhotoData             Bytes?
  groupPhotoMimeType         String?
  groupPhotoUploadedAt       DateTime?
  siteArrivalPhotoData       Bytes?
  siteArrivalPhotoMimeType   String?
  siteArrivalPhotoUploadedAt DateTime?
  approvedForWork            Boolean   @default(false)
  approvedAt                 DateTime?
  notes                      String?

  workers   SafetyCheckWorker[]
  incidents SafetyIncident[]

  @@index([projectId])
  @@index([checkDate])
}

model SafetyCheckWorker {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  safetyCheckId String
  safetyCheck   DailySafetyCheck @relation(fields: [safetyCheckId], references: [id], onDelete: Cascade)

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  workerName      String
  hasVest         Boolean   @default(false)
  hasHardHat      Boolean   @default(false)
  hasBoots        Boolean   @default(false)
  hasUniform      Boolean   @default(false)
  photoData       Bytes?
  photoMimeType   String?
  photoUploadedAt DateTime?
  passed          Boolean   @default(false)
  notes           String?

  incidents SafetyIncident[]

  @@index([safetyCheckId])
  @@index([employeeId])
}

model SafetyIncident {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  safetyCheckWorkerId String
  safetyCheckWorker   SafetyCheckWorker @relation(fields: [safetyCheckWorkerId], references: [id], onDelete: Cascade)

  safetyCheckId String
  safetyCheck   DailySafetyCheck @relation(fields: [safetyCheckId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  workerName String
  checkDate  DateTime

  /// OPEN | RESOLVED | ESCALATED
  status             String    @default("OPEN")
  resolvedAt         DateTime?
  escalatedAt        DateTime?
  notificationSentAt DateTime?
  escalationSentAt   DateTime?

  /// Running total of violations for this worker at time of creation
  violationCount Int @default(1)

  @@index([projectId])
  @@index([employeeId])
  @@index([status])
  @@index([safetyCheckId])
  @@index([safetyCheckWorkerId])
}

model ProjectWorkOrder {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title          String
  location       String?
  requestedBy    String?
  priority       String    @default("MEDIUM")
  dueDate        DateTime?
  scopeDetails   String?
  specifications String?
  supportInfo    String?
  photoUrls      Json?

  @@index([projectId, createdAt])
  @@index([priority])
  @@index([dueDate])
}

model ProjectWorkOrderAttachment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  filename String
  mimeType String
  size     Int
  data     Bytes

  @@index([projectId])
}

model ProjectChecklistItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// The calendar date this item belongs to (stored as midnight UTC)
  date      DateTime
  title     String
  completed Boolean  @default(false)
  notes     String?

  @@index([projectId, date])
}

/// One persistent work order record per project — editable, resendable
model ProjectWorkOrderRecord {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  projectName String
  siteAddress String?
  contacts    String?
  startDate   String?
  serviceType String?
  notes       String?

  /// Denormalized for display — set when email is sent
  lastSentToName String?
  lastSentAt     DateTime?
}

model ProjectImage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  imageUrl   String
  caption    String?
  uploadedBy String?
  takenAt    DateTime?

  @@index([projectId, createdAt])
}

model ProjectChangeOrder {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title               String
  description         String?
  requestedBy         String?
  supervisor          String?
  /// The CO's own current supervisor, mirroring Project.supervisorUserId —
  /// kept in sync the same way, written whenever a ChangeOrderDayAssignment
  /// sets a supervisor. Distinct from the free-text `supervisor` field above
  /// (a name string, not a real ErpUser link). Drives the "needs a
  /// supervisor" calendar warning for COs the same way Project.supervisorUserId
  /// drives it for projects.
  supervisorUserId    String?
  supervisorUser      ErpUser?  @relation("ChangeOrderSupervisor", fields: [supervisorUserId], references: [id], onDelete: SetNull)
  status              String    @default("DRAFT")
  requestedDate       DateTime? @default(now())
  startDate           DateTime?
  /// Target end date — like Project.projectEndDate, this plus startDate lets
  /// the CO show automatically on the schedule calendar on both its start
  /// and end day. Days in between need an explicit ProjectDayAssignment (see
  /// ProjectDayAssignment.changeOrders) to show up.
  endDate             DateTime?
  billingStatus       String?
  percentInvoiced     Int       @default(0)
  completedAt         DateTime?
  estimatedCostCents  Int?
  estimatedDays       Int?
  reason              String?
  resolutionNotes     String?
  contractValueCents  Int?
  estMaterialCents    Int?
  estTravelCents      Int?
  estLaborCents       Int?
  actualLaborCents    Int?
  actualMaterialCents Int?
  actualTravelCents   Int?
  estHours            Float?
  actualHours         Float?
  estLaborers         Int?
  estSupervisors      Int?

  /// Sales commission on this CO is marked paid here — separate from the
  /// parent project's own commissionPaidAt, since a CO only becomes
  /// commissionable once it's COMPLETED and its billingStatus is paid
  /// (see resolveCommissionEmployeeId / payroll page), independent of when
  /// the base project's own commission was paid out.
  commissionPaidAt DateTime?

  laborers              ProjectChangeOrderLaborer[]
  contracts             ChangeOrderContract[]
  materialEntries       ChangeOrderMaterialEntry[]
  contractorAssignments ChangeOrderContractorAssignment[]
  /// Day assignments explicitly scheduling crew for this CO on a day between
  /// its start and end (or beyond) — same day-assignment mechanism used to
  /// plan regular project work, just tagged to this CO instead.
  dayAssignments        ProjectDayAssignment[]            @relation("DayAssignmentChangeOrders")
  /// This CO's own supervisor/PM day assignments — same concept as
  /// ProjectDayAssignment but scoped to the CO directly (see
  /// ChangeOrderDayAssignment), not just tagged onto a project's day.
  coDayAssignments      ChangeOrderDayAssignment[]
  /// This CO's own planned crew, same concept as ProjectWorkerDayAssignment
  /// but scoped to the CO directly (see ChangeOrderWorkerDayAssignment).
  coWorkerAssignments   ChangeOrderWorkerDayAssignment[]

  @@index([projectId, createdAt])
  @@index([status])
}

/// A planned supervisor/PM coverage of a ProjectChangeOrder on a specific
/// day — same idea as ProjectDayAssignment, but scoped to a CO directly
/// instead of the parent project, so a CO can be scheduled (and show a
/// "needs a supervisor" warning) independently of the project's own day
/// assignments. No seriesId/sovItems/scopeItems — repeat-scheduling and
/// SOV/scope tagging aren't supported for COs yet, unlike projects.
model ChangeOrderDayAssignment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  changeOrderId String
  changeOrder   ProjectChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)

  /// The calendar date this assignment is for (stored as midnight UTC)
  date DateTime

  /// Optional "HH:MM" (24h) local time, e.g. "08:00". All-day event on the
  /// calendar invite if either time is unset.
  startTime String?
  endTime   String?

  /// Nullable so a day can be covered by a PM only, see
  /// ProjectDayAssignment.projectManagerUserId for the same rare case.
  supervisorUserId String?
  supervisorUser   ErpUser? @relation("ChangeOrderDayAssignmentSupervisor", fields: [supervisorUserId], references: [id], onDelete: Cascade)

  /// Set when only the PM is at the CO's work that day, no supervisor. Not
  /// synced onto ProjectChangeOrder (unlike supervisorUserId), calendar/
  /// day-assignment concept only, no calendar-invite email for it.
  projectManagerUserId String?
  projectManager       ErpUser? @relation("ChangeOrderDayAssignmentPM", fields: [projectManagerUserId], references: [id], onDelete: SetNull)

  /// Free-text note about what's happening this day.
  comment String?

  @@unique([changeOrderId, date])
  @@index([date])
  @@index([supervisorUserId])
  @@index([projectManagerUserId])
}

/// A worker planned to be on a change order's work on a future day, before
/// any labor is logged — same idea as ProjectWorkerDayAssignment but scoped
/// to a CO instead of the parent project, and multiple per CO/day since a
/// crew has more than one person.
model ChangeOrderWorkerDayAssignment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  changeOrderId String
  changeOrder   ProjectChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)

  /// Exactly one of employeeId/contractorId is set per row.
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  contractorId String?
  contractor   Contractor? @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  /// The calendar date this assignment is for (stored as midnight UTC)
  date DateTime

  @@unique([changeOrderId, employeeId, date])
  @@unique([changeOrderId, contractorId, date])
  @@index([date])
  @@index([employeeId])
  @@index([contractorId])
}

/// A contractor logged on a change order — same idea as ContractorAssignment
/// on Project, but scoped to the CO instead.
model ChangeOrderContractorAssignment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  changeOrderId String
  changeOrder   ProjectChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)

  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  role         String?
  assignedDate DateTime?
  startDate    DateTime?
  endDate      DateTime?
  notes        String?
  costCents    Int?

  @@index([changeOrderId])
  @@index([contractorId])
}

model ProjectChangeOrderLaborer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  changeOrderId String
  changeOrder   ProjectChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  name            String
  role            String?
  workDate        DateTime @default(now())
  hours           Float    @default(0)
  /// Clock-in time as "HH:MM" (24h), e.g. "08:00". Null for entries logged before this field existed.
  clockIn         String?
  /// Cents per hour (e.g. $28.84/hr → 2884)
  hourlyRateCents Int      @default(0)
  taskDescription String?

  qualityRating String?
  qualityNotes  String?
  completed     Boolean @default(false)

  @@index([changeOrderId])
}

model ProjectContract {
  id                   String    @id @default(cuid())
  createdAt            DateTime  @default(now())
  projectId            String
  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractPdfFilename  String?
  docusealTemplateId   Int?
  signingStatus        String    @default("SIGNED")
  customerEmail        String?
  docusealSubmissionId Int?      @unique
  signedAt             DateTime?
  signedDocumentUrl    String?

  @@index([projectId])
  @@index([docusealTemplateId])
}

model ChangeOrderContract {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  changeOrderId String
  changeOrder   ProjectChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)

  contractPdfFilename  String?
  docusealTemplateId   Int?
  signingStatus        String?
  customerEmail        String?
  docusealSubmissionId Int?
  signedAt             DateTime?
  signedDocumentUrl    String?

  @@index([changeOrderId])
  @@index([docusealSubmissionId])
  @@index([docusealTemplateId])
}

model ProjectContact {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  fullName         String
  role             String?
  company          String?
  email            String?
  phone            String?
  notes            String?
  hubspotContactId String?
  /// HUBSPOT | MANUAL
  source           String  @default("MANUAL")
  isPrimary        Boolean @default(false)

  @@unique([projectId, hubspotContactId])
  @@index([projectId, createdAt])
  @@index([projectId, source])
  @@index([email])
  @@index([phone])
